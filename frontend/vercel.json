{
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://toevent.onrender.com/api/$1",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-origin-secret" },
          "args": "$PROXY_SHARED_SECRET",
          "env": ["PROXY_SHARED_SECRET"]
        }
      ]
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
